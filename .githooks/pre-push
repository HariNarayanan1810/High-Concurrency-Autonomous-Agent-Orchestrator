#!/bin/sh
set -eu

zero=0000000000000000000000000000000000000000
while read -r local_ref local_oid remote_ref remote_oid; do
    case "$remote_ref" in
        refs/heads/main|refs/heads/master)
            echo "Direct pushes/deletions of main are blocked. Push a feature branch and open a PR." >&2
            exit 1 ;;
    esac
    [ "$local_oid" = "$zero" ] && continue
    case "$remote_ref" in
        refs/heads/feature/*|refs/heads/fix/*|refs/heads/docs/*|refs/heads/chore/*|refs/heads/test/*) ;;
        *) echo "Push a feature/, fix/, docs/, chore/, or test/ branch." >&2; exit 1 ;;
    esac

    if [ "$remote_oid" != "$zero" ] && git cat-file -e "$remote_oid^{commit}" 2>/dev/null; then
        commits=$(git rev-list "$remote_oid..$local_oid")
    else
        commits=$(git rev-list "$local_oid" --not --remotes)
    fi
    for commit in $commits; do
        if ! git cat-file commit "$commit" | sed -n '1,/^$/p' | grep -q '^gpgsig '; then
            echo "Unsigned outgoing commit $commit. Sign your commits before pushing." >&2
            exit 1
        fi
    done
done

# Signature presence is checked locally; GitHub must verify the key and enforce main's rules.
